# Backend Environment Variables
# Copy this to .env and fill in your values

# ── LLM / Vision / OCR ─────────────────────────────
# Gemini (Google AI Studio, OpenAI-compatible) — PRIMARY text + vision provider.
# Free tier is the only one currently able to feed this pipeline's call volume.
# Get a key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here
# (VISION_MODEL_API_KEY / GOOGLE_EMBEDDING_KEY may be used instead and are picked up automatically)

# Mistral — secondary provider (hard-limited on some accounts: OCR may be 0 RPM)
# Key name is OCR_KEY (kept for historical reasons). Optional second account: MISTRAL_API_KEY_2
OCR_KEY=your_mistral_api_key_here
MISTRAL_API_KEY_2=

# Groq — tertiary, text-only
# Get one at: https://console.groq.com/
GROQ_API_KEY=your_groq_api_key_here

# ── Database ────────────────────────
# Default: local Docker Postgres
# Override for production / Railway:
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/papers

# ── LLM Models ─────────────────────
GEMINI_MODEL=gemini-2.5-flash-lite
MISTRAL_LLM_MODEL=ministral-8b-latest
VISION_MODEL=gemini-2.5-flash-lite
GROQ_EXTRACT_MODEL=openai/gpt-oss-120b
GROQ_EVAL_MODEL=openai/gpt-oss-120b
GROQ_EXPLAIN_MODEL=openai/gpt-oss-120b

# ── Security ───────────────────────
# Change in production!
MASTER_API_KEY=change_me_in_production
API_KEYS=
# Key used by the Next.js server-side proxies only (never NEXT_PUBLIC_*).
PROXY_API_KEY=change_me_too

# ── Rate Limiting ──────────────────
RATE_LIMIT_DEFAULT=60/minute
RATE_LIMIT_STREAM=10/minute
RATE_LIMIT_CHAT=30/minute
RATE_LIMIT_SUBMIT=20/minute

# ── Processing ─────────────────────
MAX_UPLOAD_SIZE_MB=25
MAX_SECTION_CHARS=18000
LLM_MAX_RETRIES=4
LLM_RETRY_BACKOFF_BASE=3

# ── Misc ───────────────────────────
DEBUG=false
